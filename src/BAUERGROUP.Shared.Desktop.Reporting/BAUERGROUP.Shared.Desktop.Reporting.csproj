<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net8.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <PackageId>BAUERGROUP.Shared.Desktop.Reporting</PackageId>
    <Description>Report generation and visualization powered by Stimulsoft Reports with WPF designer and viewer integration.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Stimulsoft Version bleibt wegen Lizenz auf 2022.1.2 -->
    <PackageReference Include="Stimulsoft.Dashboards.Win" />
    <PackageReference Include="Stimulsoft.Reports.Wpf" />
    <!-- Stimulsoft 2022.1.2 resolves System.Data.SqlClient 4.7.0, which has known advisories
         (GHSA-98g6-xh36-x2p7 high, GHSA-8g2p-5pqh-5jmc moderate); this lifts it to a fixed version -->
    <PackageReference Include="System.Data.SqlClient" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BAUERGROUP.Shared.Desktop\BAUERGROUP.Shared.Desktop.csproj" />
  </ItemGroup>

</Project>
