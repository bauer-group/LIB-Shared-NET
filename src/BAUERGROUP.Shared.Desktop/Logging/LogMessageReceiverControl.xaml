<UserControl x:Class="BAUERGROUP.Shared.Desktop.Logging.LogMessageReceiverControl"
             x:ClassModifier="public"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:BAUERGROUP.Shared.Desktop.Logging"
             xmlns:behaviours="clr-namespace:BAUERGROUP.Shared.Desktop.Behaviours"
             xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="800" IsVisibleChanged="UserControl_IsVisibleChanged">
    <UserControl.Resources>
        <SolidColorBrush x:Key="LogViewerWarningForeground" Color="#9D5D00" />
        <SolidColorBrush x:Key="LogViewerErrorForeground" Color="#C42B1C" />
    </UserControl.Resources>
    <UserControl.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Copy" Executed="OnCopyExecuted" CanExecute="OnCopyCanExecute" />
    </UserControl.CommandBindings>
    <DockPanel x:Name="containerGrid">
        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="4,2">
            <TextBlock x:Name="PART_Status" DockPanel.Dock="Left" VerticalAlignment="Center" />
            <Button x:Name="PART_Clear" DockPanel.Dock="Right" Content="Clear" Margin="4,0,0,0" Click="OnClearClick" />
            <Button x:Name="PART_Copy" DockPanel.Dock="Right" Content="Copy" Command="ApplicationCommands.Copy" />
            <ToggleButton x:Name="PART_Follow" DockPanel.Dock="Right" Content="Follow" IsChecked="True" Margin="0,0,4,0"
                          Checked="OnFollowChanged" Unchecked="OnFollowChanged" />
        </DockPanel>
        <ListBox x:Name="PART_List" SelectionMode="Extended" FontFamily="Cascadia Mono, Consolas"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="4,0" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayText, Mode=OneTime}" TextWrapping="NoWrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource LogViewerWarningForeground}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource LogViewerErrorForeground}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ContextMenu>
                <ContextMenu>
                    <!-- A ContextMenu lives in its own popup tree, so a routed command raised inside it never
                         reaches the CommandBinding on this UserControl. CommandTarget points the command back
                         at the list the menu was opened on, which does route. -->
                    <MenuItem Header="Copy" Command="ApplicationCommands.Copy"
                              CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="Copy all" Click="OnCopyAllClick" />
                    <MenuItem Header="Clear" Click="OnClearClick" />
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>
    </DockPanel>
</UserControl>
