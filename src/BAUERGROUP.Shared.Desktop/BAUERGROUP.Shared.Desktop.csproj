<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net8.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PackageId>BAUERGROUP.Shared.Desktop</PackageId>
    <Description>Windows Presentation Foundation (WPF) infrastructure including UI helpers, dialog management, Windows services integration, and printing support.</Description>
  </PropertyGroup>

  <!-- WPF resource behind "/BAUERGROUP.Shared.Desktop;component/Images/Application.ico",
       used as the window icon by this package and by Desktop.Browser -->
  <ItemGroup>
    <Resource Include="..\BAUERGROUP.Shared.Core\Images\Application.ico" Link="Images\Application.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" />
    <PackageReference Include="System.Configuration.ConfigurationManager" />
    <PackageReference Include="System.Data.Odbc" />

    <PackageReference Include="System.ServiceProcess.ServiceController" />
    <PackageReference Include="System.Text.Encoding.CodePages" />
    <PackageReference Include="System.Collections.Immutable" />
    <PackageReference Include="System.Reactive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BAUERGROUP.Shared.Core\BAUERGROUP.Shared.Core.csproj" />
  </ItemGroup>

</Project>
