<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0;netstandard2.0</TargetFrameworks>
    <PackageId>BAUERGROUP.Shared.Core</PackageId>
    <Description>Enterprise-grade core library providing logging infrastructure, file system utilities, periodic task scheduling, extension methods, and resilience patterns for .NET applications.</Description>
  </PropertyGroup>

  <!-- The public key may only be part of the attribute when this build actually signs: CI builds
       without the signing key (pull requests cannot read the secret) produce unsigned assemblies,
       and a keyed InternalsVisibleTo would then fail the test project with CS0281. -->
  <ItemGroup>
    <InternalsVisibleTo Include="BAUERGROUP.Shared.Test" Key="$(AssemblyPublicKey)" Condition="'$(SignAssembly)' == 'true'" />
    <InternalsVisibleTo Include="BAUERGROUP.Shared.Test" Condition="'$(SignAssembly)' != 'true'" />
  </ItemGroup>

  <!-- Common packages (all TFMs) -->
  <ItemGroup>
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="HtmlAgilityPack" />
    <PackageReference Include="NLog" />
    <PackageReference Include="NLog.Extensions.Logging" />
    <PackageReference Include="NLog.Targets.Mail" />
    <PackageReference Include="NLog.Targets.Network" />
    <PackageReference Include="NLog.Targets.Trace" />
    <PackageReference Include="NLog.Targets.WebService" />
    <PackageReference Include="Polly" />
    <PackageReference Include="Polly.Extensions" />
    <PackageReference Include="Sentry" />
    <PackageReference Include="Sentry.NLog" />
    <PackageReference Include="SharpZipLib" />
    <PackageReference Include="System.Configuration.ConfigurationManager" />
    <PackageReference Include="System.Runtime.Caching" />
  </ItemGroup>

  <!-- Windows-only packages -->
  <ItemGroup Condition="!$(TargetFramework.StartsWith('netstandard'))">
    <PackageReference Include="NLog.WindowsEventLog" />
  </ItemGroup>

  <!-- netstandard2.0 polyfills -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Collections.Immutable" VersionOverride="10.0.5" />
    <PackageReference Include="System.Text.Json" VersionOverride="8.0.5" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" VersionOverride="8.0.0" />
  </ItemGroup>

</Project>
