<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Build & Source Link -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.300" />
    <!-- Core / Utilities -->
    <PackageVersion Include="NLog" Version="6.1.4" />
    <PackageVersion Include="NLog.Extensions.Logging" Version="6.1.4" />
    <PackageVersion Include="NLog.WindowsEventLog" Version="6.1.4" />
    <!-- NLog 6.0 separate target packages -->
    <PackageVersion Include="NLog.Targets.Mail" Version="6.1.1" />
    <PackageVersion Include="NLog.Targets.Network" Version="6.0.4" />
    <PackageVersion Include="NLog.Targets.Trace" Version="6.0.3" />
    <PackageVersion Include="NLog.Targets.WebService" Version="6.1.1" />
    <PackageVersion Include="Polly" Version="8.7.0" />
    <PackageVersion Include="Polly.Extensions" Version="8.7.0" />
    <PackageVersion Include="Sentry" Version="6.10.0" />
    <PackageVersion Include="Sentry.NLog" Version="6.10.0" />
    <!-- Data / Persistence -->
    <PackageVersion Include="LiteDB" Version="5.0.21" />
    <PackageVersion Include="NMemory" Version="3.1.6" />
    <PackageVersion Include="sqlite-net-pcl" Version="1.11.285" />
    <PackageVersion Include="System.Runtime.Caching" Version="10.0.9" />
    <!-- File Processing -->
    <PackageVersion Include="CsvHelper" Version="33.1.0" />
    <PackageVersion Include="SharpZipLib" Version="1.4.2" />
    <PackageVersion Include="HtmlAgilityPack" Version="1.12.4" />
    <!-- HTTP / API -->
    <PackageVersion Include="RestSharp" Version="114.0.0" />
    <!-- Cloud Services -->
    <PackageVersion Include="CloudinaryDotNet" Version="1.29.2" />
    <!-- Reactive Extensions -->
    <PackageVersion Include="System.Reactive" Version="6.1.0" />
    <!-- Windows Desktop (WPF/WinForms) -->
    <PackageVersion Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.142" />
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
    <PackageVersion Include="Microsoft.Win32.SystemEvents" Version="10.0.9" />
    <PackageVersion Include="System.Configuration.ConfigurationManager" Version="10.0.9" />
    <PackageVersion Include="System.Data.Odbc" Version="10.0.9" />

    <PackageVersion Include="System.ServiceProcess.ServiceController" Version="10.0.9" />
    <PackageVersion Include="System.Text.Encoding.CodePages" Version="10.0.9" />
    <PackageVersion Include="System.Collections.Immutable" Version="10.0.9" />
    <!-- CefSharp (Chromium Embedded Framework) -->
    <PackageVersion Include="CefSharp.Common.NETCore" Version="152.0.60" />
    <PackageVersion Include="CefSharp.OffScreen.NETCore" Version="152.0.60" />
    <PackageVersion Include="CefSharp.Wpf.NETCore" Version="152.0.60" />
    <!-- Cross-platform Desktop (Avalonia) -->
    <PackageVersion Include="Avalonia" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.2" />
    <!-- Reporting (Stimulsoft) - Version bleibt wegen Lizenz! -->
    <PackageVersion Include="Stimulsoft.Dashboards.Win" Version="2022.1.2" />
    <PackageVersion Include="Stimulsoft.Reports.Wpf" Version="2022.1.2" />
    <!-- Polyfills for netstandard2.0 / net8.0 -->
    <PackageVersion Include="PolySharp" Version="1.16.0" />
    <PackageVersion Include="System.Text.Json" Version="10.0.2" />
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.2" />
    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <!-- Pinned to 3.x: Avalonia.Headless.XUnit 12.1.2 fails test discovery on xunit.v3 4.x
         (MissingMethodException), and 4.x forces Microsoft.Testing.Platform, which breaks
         "dotnet test" over the whole solution on the .NET 10 SDK. A major-version bump of this
         package must be rejected until Avalonia.Headless.XUnit supports it. -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
  </ItemGroup>
</Project>